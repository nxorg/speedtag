{
  "manifest_version": 3,
  "name": "nxorg Video Speed",
  "version": "1.0.0",
  "description": "Shows the current playback speed at the top-left of every playing video. Change speed with [ ] \\ keys or the toolbar popup.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg",
    "default_title": "nxorg Video Speed"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "videospeed@nxorg.xchip.in",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
